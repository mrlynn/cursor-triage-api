{
  "name": "cursor-triage-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A teaching-grade Northwind support-triage service on Cursor's Agent SDK, offered beside mrlynn/claude-triage-api as a side-by-side API comparison.",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
