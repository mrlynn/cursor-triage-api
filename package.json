  },
  "dependencies": {
    "@cursor/sdk": "^1.0.30",
    "@hono/node-server": "^1.19.0",
    "hono": "^4.6.14",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "tsx": "^4.19.2",
    "typescript": "^5.8.2"
  }
